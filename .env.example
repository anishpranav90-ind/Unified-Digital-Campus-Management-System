# ---------------------------------------------------------------------------
# UniSync environment
# Copy to .env.local for local development. Never commit real credentials.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Either credential lets the local scripts manage the database:
#   SUPABASE_SERVICE_ROLE_KEY  Supabase admin API (auth admin + PostgREST)
#   SUPABASE_DB_URL            direct Postgres connection string, e.g. the
#                              session pooler URL from Project Settings → Database
# scripts/seed-demo.mjs uses the service-role key when present, otherwise the
# database URL. Neither is ever imported into client code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Public application origin used by auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave blank for automatic detection:
#   true  = seeded in-memory demo backend (default while Supabase keys are blank)
#   false = require Supabase
NEXT_PUBLIC_DEMO_MODE=

# Demo login password used by the in-memory backend and demo seeder
DEMO_PASSWORD=unisync123

# Configure the print mode in the PrintPulse admin settings. Set each URI to
# its matching CUPS queue. These values are server-only; use IPPS with auth.
CUPS_SJIT_GIRLS_XEROX_1_URI=ipps://printer.example.edu:631/ipp/sjit-girls-xerox-1
CUPS_SJIT_BOYS_XEROX_1_URI=ipps://printer.example.edu:631/ipp/sjit-boys-xerox-1
CUPS_SJCE_BOYS_XEROX_1_URI=ipps://printer.example.edu:631/ipp/sjce-boys-xerox-1
CUPS_SJCE_GIRLS_XEROX_1_URI=ipps://printer.example.edu:631/ipp/sjce-girls-xerox-1
CUPS_SJIT_PERIWINKLE_XEROX_URI=ipps://printer.example.edu:631/ipp/sjit-periwinkle-xerox
CUPS_USERNAME=
CUPS_PASSWORD=
CUPS_REQUESTING_USER=unisync
